# Boolean perf regression: SDT16_6x6 (poly vs diff)
# Run from src/: ./MAGPARSER.exe ../Regressions/boolean_perf_sdt16.ctr 10
program bool_perf_sdt
systeminfo
var debug_verbosity 0
decl design d1 = /scratch1/skoranne/OSS_EDA_TOOLS/DESIGNS/SDT16_DATA/SDT16_6x6.mag
decl memory m1 = nothing
info
exec init m1:nothing
exec run m1:and_pd = d1:poly * d1:diff
exec run m1:or_pd  = d1:poly + d1:diff
exec run m1:xor_pd = d1:poly ^ d1:diff
exec run m1:not_pd = d1:poly ! d1:diff
flush
end
