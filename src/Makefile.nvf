################################################################################
# File   : Makefile.nvf
# Author : Sandeep Koranne (Refactored)
# ml /opt/nvidia/hpc_sdk/modulefiles/nvhpc-hpcx-cuda13/26.1
################################################################################

# --- Compiler & Flags ---
HDF5_FC=nvfortran
FORTRAN_COMPILER =nvfortran
# Debug flags (commented out, but easily swappable)
# FCFLAGS = -check bounds -check all -traceback -O3 -parallel -qopenmp -qopt-report=3 -xHost 
# Use -pg
#FCFLAGS = -g -O0 -check bounds -check all -traceback -warn all -qopenmp -qopt-report=3
#FCFLAGS = -O3 -parallel -qopenmp -qopt-report=3
GIT_HASH := $(shell git rev-parse --short HEAD)
# GPU/OpenMP target tuning (nvfortran). Override as needed, e.g. make -f Makefile.nvf GPU_CC=cc121
GPU_CC ?= ccnative
NSYS ?= nsys
NSYS_DELAY ?= 0
NSYS_DUR ?= 0
NSYS_TRACE ?= cuda,nvtx,openmp,osrt
NSYS_OUT ?= /tmp/magparser_nvf_profile
STRICT ?= 0
ifeq ($(DEBUG),1)
   FCFLAGS = -cuda -O0 -Mbounds -g -traceback -Mchkptr -Mpreprocess -mp=gpu -gpu=$(GPU_CC) -fopenmp -Minfo=accel,mp
else
   FCFLAGS = -cuda -O3 -g -fno-strict-aliasing -Mpreprocess -mp=gpu -gpu=$(GPU_CC) -fopenmp -Minfo=accel,mp
endif
ifeq ($(STRICT),1)
   FCFLAGS += -Mstandard -Mbounds -Mchkptr -Minform=inform -traceback
endif
#FCFLAGS = -g -O3 -Mpreprocess -Minfo=accel -fopenmp -mp=gpu
# --- Linker Variables ---
#LDFLAGS = -L/scratch1/skoranne/INTELCOMPILERS/lib/
LDFLAGS = -L/scratch1/skoranne/NVCOMPILERS/lib/
LDLIBS = db/liblayoutdb.a -lz -lstdc++ -lsnappy -lzstd
#LDLIBS = -lz -lhdf5_fortran -lhdf5
# --- Library Definition ---
LIBRARY = libmagparser.a

include DEPENDENCIES.txt
#skiplist_module.o
box_codec.o:	box_codec.f90
	nvfortran -Mpreprocess -c -O1 -g -cuda box_codec.f90

# Create a list of all object files that will be compiled
ALL_OBJS = $(LIB_OBJS) mainmagparser.o test_contour.o

# Derive a list of dependency (.d) files from the object list
DEP_FILES = $(ALL_OBJS:.o=.d)

# --- Phony Targets ---
# Tells Make these aren't actual files to generate
.PHONY: all clean unit_test profile profile-delayed

all: MAGPARSER.exe
# This target writes a small .f90 module containing the hash
version_mod.f90: ../.git/HEAD ../.git/index
	@echo "module version_mod" > $@
	@echo "  implicit none" >> $@
	@echo "  character(len=*), parameter :: commit_hash = '$(GIT_HASH)'" >> $@
	@echo "end module version_mod" >> $@

unit_test: test_contour.exe test_morton.exe test_polygonfracture.exe test_boxmerge.exe \
	   test_skiplist.exe

clean:
	rm -f *.o *.mod *.a *.exe

# Generating specific versions
#merge_utils.o: merge_utils.F90 SkipList_template.inc
#    $(FC) $(FFLAGS) -DPAYLOAD_TYPE="type(ScanBox)" -DPROC_PREFIX="scanbox_" -c merge_utils.F90 -o merge_utils.o

# --- Pattern Rules ---
# This single rule replaces all the individual ".f90 -> .o" targets.
# $< = the first dependency (the .f90 file)
# $@ = the target (the .o file)
#%.o: %.f90
#	$(FORTRAN_COMPILER) $(FCFLAGS) -gen-dep=$(@:.o=.d) -c $< -o $@
%.o: %.f90
	$(FORTRAN_COMPILER) $(FCFLAGS) -c $< -o $@
%.o: %.F90
	$(FORTRAN_COMPILER) $(FCFLAGS) -fpp -gen-dep=$(@:.o=.d) -c $< -o $@

# --- Library Creation ---
# Bundles all the core objects into a single static library.
# $^ = all dependencies (all files in LIB_OBJS)
$(LIBRARY): $(LIB_OBJS)
	ar rcs $@ $^

# --- Executable Builds ---
# By linking against the library, we don't have to list out all objects again.
MAGPARSER.exe: mainmagparser.o $(LIBRARY)
	$(FORTRAN_COMPILER) $(FCFLAGS) $^ -o $@ $(LDFLAGS) $(LDLIBS)

test_contour.exe: test_contour.o $(LIBRARY)
	$(FORTRAN_COMPILER) $(FCFLAGS) $^ -o $@ $(LDFLAGS) $(LDLIBS)
test_morton.exe: test_morton.o $(LIBRARY)
	$(FORTRAN_COMPILER) $(FCFLAGS) $^ -o $@ $(LDFLAGS) $(LDLIBS)
CONVERT.exe: test_polygonfracture.o $(LIBRARY)
	$(FORTRAN_COMPILER) $(FCFLAGS) $^ -o $@ $(LDFLAGS) $(LDLIBS)
test_boxmerge.exe: test_boxmerge.o $(LIBRARY)
	$(FORTRAN_COMPILER) $(FCFLAGS) $^ -o $@ $(LDFLAGS) $(LDLIBS)
test_skiplist.exe: test_skiplist.o $(LIBRARY)
	$(FORTRAN_COMPILER) $(FCFLAGS) $^ -o $@ $(LDFLAGS) $(LDLIBS)
generate_bin.exe: generate_bin.o $(LIBRARY)
	$(FORTRAN_COMPILER) $(FCFLAGS) $^ -o $@ $(LDFLAGS) $(LDLIBS)
test_interaction.exe:	test_interaction.f90 $(LIBRARY)
	$(FORTRAN_COMPILER) $(FCFLAGS) $^ -o $@ $(LDFLAGS) $(LDLIBS)
test_repetition.exe:	test_repetition.f90 $(LIBRARY)
	$(FORTRAN_COMPILER) $(FCFLAGS) $^ -o $@ $(LDFLAGS) $(LDLIBS)
BOOST_XOR_CHECKER.exe: boost_xor_checker.cpp
		       g++ -O3 -funroll-loops -I /scratch1/skoranne/OSS_EDA_TOOLS/boost/boost boost_xor_checker.cpp -o BOOST_XOR_CHECKER.exe
systeminfo_macos.o: systeminfo_macos.c
		       $(CC) -O3 -Wall -c systeminfo_macos.c -o $@
snappy_api.o:	       snappy_api.cpp
		       g++ -O3 -Wall -c snappy_api.cpp -o snappy_api.o
systeminfo_macos.o: systeminfo_macos.c
		       $(CC) -O3 -Wall -c systeminfo_macos.c -o $@
boost_polygon_api.o:   boost_polygon_api.cpp
		       g++ -O3 -funroll-loops -I /scratch1/skoranne/OSS_EDA_TOOLS/boost/boost boost_polygon_api.cpp -c
event_sorter.o:	       event_sorter.cu
		       nvcc -arch=sm_121 -DUSE_GPU -O3 -c event_sorter.cu
gpu_morton.o:   gpu_morton.cu
		       nvcc -arch=sm_121 -DUSE_GPU -O3 -c gpu_morton.cu
# Nsight Systems profiling for nvfortran+OpenMP target offload (GB10). Example:
#   make -f Makefile.nvf profile CTR=check_interactions.ctr LAYERS=10
#   make -f Makefile.nvf profile-delayed NSYS_DELAY=30 NSYS_DUR=60 CTR=check_interactions.ctr LAYERS=10
CTR ?= regress_boolean_ops.ctr
LAYERS ?= 10
profile: MAGPARSER.exe
	$(NSYS) profile -t $(NSYS_TRACE) --cuda-memory-usage=true --stats=true \
	  -o $(NSYS_OUT) --force-overwrite true \
	  ./MAGPARSER.exe $(CTR) $(LAYERS)

profile-delayed: MAGPARSER.exe
	$(NSYS) profile -t $(NSYS_TRACE) --cuda-memory-usage=true --stats=true \
	  --delay=$(NSYS_DELAY) --duration=$(NSYS_DUR) \
	  -o $(NSYS_OUT)_d$(NSYS_DELAY)_t$(NSYS_DUR) --force-overwrite true \
	  ./MAGPARSER.exe $(CTR) $(LAYERS)

ALL_EXE:    CONVERT.exe test_interaction.exe test_repetition.exe BOOST_XOR_CHECKER.exe generate_bin.exe test_contour.exe


