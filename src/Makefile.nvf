################################################################################
# File   : Makefile.nvf
# Author : Sandeep Koranne (Refactored)
# ml /opt/nvidia/hpc_sdk/modulefiles/nvhpc-hpcx-cuda13/26.1
################################################################################

# --- Auto-detect NVIDIA HPC SDK & CUDA toolchains ---
UNAME_M := $(shell uname -m)
NVHPC_ROOT ?= /opt/nvidia/hpc_sdk
NVHPC_BIN := $(shell if command -v nvfortran >/dev/null 2>&1; then dirname "$$(command -v nvfortran)"; else ls -d $(NVHPC_ROOT)/Linux_$(UNAME_M)/[0-9][0-9].[0-9]*/compilers/bin $(NVHPC_ROOT)/Linux_$(UNAME_M)/20*/compilers/bin 2>/dev/null | sort -V | tail -n 1; fi)
NVHPC_CUDA_BIN := $(shell if [ -n "$(NVHPC_BIN)" ] && [ -d "$(NVHPC_BIN)/../../cuda/bin" ]; then cd "$(NVHPC_BIN)/../../cuda/bin" && pwd; elif [ -d /usr/local/cuda/bin ]; then echo /usr/local/cuda/bin; fi)
ifneq ($(NVHPC_BIN),)
export PATH := $(NVHPC_BIN):$(NVHPC_CUDA_BIN):/usr/local/cuda/bin:$(PATH)
endif

# --- Compiler & Flags ---
HDF5_FC ?= $(if $(NVHPC_BIN),$(NVHPC_BIN)/nvfortran,nvfortran)
FORTRAN_COMPILER ?= $(if $(NVHPC_BIN),$(NVHPC_BIN)/nvfortran,nvfortran)
NVCC ?= $(if $(wildcard $(NVHPC_CUDA_BIN)/nvcc),$(NVHPC_CUDA_BIN)/nvcc,nvcc)
# Debug flags (commented out, but easily swappable)
# FCFLAGS = -check bounds -check all -traceback -O3 -parallel -qopenmp -qopt-report=3 -xHost 
# Use -pg
#FCFLAGS = -g -O0 -check bounds -check all -traceback -warn all -qopenmp -qopt-report=3
#FCFLAGS = -O3 -parallel -qopenmp -qopt-report=3
GIT_HASH := $(shell git rev-parse --short HEAD)
# GPU/OpenMP target tuning (nvfortran). Override as needed, e.g. make -f Makefile.nvf GPU_CC=cc121
GPU_CC ?= ccnative
# nvcc target derived from GPU_CC so .cu code always matches the OpenMP offload target:
#   ccnative -> -arch=native, ccXY -> -arch=sm_XY (e.g. cc121 -> sm_121 for GB10).
NVCC_ARCH ?= $(if $(filter ccnative,$(GPU_CC)),native,$(patsubst cc%,sm_%,$(firstword $(subst $(comma), ,$(GPU_CC)))))
comma := ,
NVCCFLAGS ?= -arch=$(NVCC_ARCH) -DUSE_GPU -O3 -lineinfo -std=c++17
NSYS ?= nsys
NSYS_DELAY ?= 0
NSYS_DUR ?= 0
NSYS_TRACE ?= cuda,nvtx,openmp,osrt
NSYS_OUT ?= /tmp/magparser_nvf_profile
STRICT ?= 0
# GPU=0: CPU-only nvfortran build for hosts with no CUDA (e.g. JN6-TX2, Jetson on Ubuntu 18.04).
#   No -cuda / -mp=gpu, the nvfortran macros are undefined so the Fortran takes the same
#   non-CUDA paths as the ifx build, and the .cu files are compiled as C++ CPU stubs.
GPU ?= 1
ifeq ($(GPU),0)
   CUDA_FLAG :=
   FCOMP_GPU := -mp -U_CUDA -U__NVCOMPILER -U__NVCOMPILER_LLVM__
   NVCOMP := 0
else
   CUDA_FLAG := -cuda
   FCOMP_GPU := -mp=gpu -gpu=$(GPU_CC) -Minfo=accel,mp
endif
ifeq ($(DEBUG),1)
   FCFLAGS = $(CUDA_FLAG) -O0 -Mbounds -g -traceback -Mchkptr -Mpreprocess $(FCOMP_GPU) -fopenmp
else
   FCFLAGS = $(CUDA_FLAG) -O3 -g -fno-strict-aliasing -Mpreprocess $(FCOMP_GPU) -fopenmp
endif
ifeq ($(STRICT),1)
   FCFLAGS += -Mstandard -Mbounds -Mchkptr -Minform=inform -traceback
endif
#FCFLAGS = -g -O3 -Mpreprocess -Minfo=accel -fopenmp -mp=gpu
# --- Linker Variables ---
#LDFLAGS = -L/scratch1/skoranne/INTELCOMPILERS/lib/
LDFLAGS = -L/scratch1/skoranne/NVCOMPILERS/lib/
# ZSTD_LIBS: override where only the runtime libzstd.so.1 exists, e.g. ZSTD_LIBS=-l:libzstd.so.1
ZSTD_LIBS ?= -lzstd
LDLIBS = db/liblayoutdb.a -lz -lstdc++ -lsnappy $(ZSTD_LIBS) -lpthread
# nvCOMP for GPU OASIS CBLOCK decompression (auto-detected; NVCOMP=0 to disable).
# nvfortran -cuda already links cudart, so only libnvcomp is added here.
include db/nvcomp.mk
LDLIBS += $(NVCOMP_LDLIBS)
#LDLIBS = -lz -lhdf5_fortran -lhdf5
# --- Library Definition ---
LIBRARY = libmagparser.a

include DEPENDENCIES.txt
#skiplist_module.o
# box_codec.f90 is miscompiled by nvfortran at -O3 (see NOTES.txt), so it defaults to -O1.
# Measured on SDT.ctr: -O2 only gains ~9% in layer flush time, so -O1 stays the safe default.
BOX_CODEC_OPT ?= -O1
box_codec.o:	box_codec.f90
	$(FORTRAN_COMPILER) -Mpreprocess -c $(BOX_CODEC_OPT) -g $(CUDA_FLAG) $(if $(filter 0,$(GPU)),$(FCOMP_GPU)) box_codec.f90

# Create a list of all object files that will be compiled
ALL_OBJS = $(LIB_OBJS) mainmagparser.o test_contour.o

# Derive a list of dependency (.d) files from the object list
DEP_FILES = $(ALL_OBJS:.o=.d)

# --- Phony Targets ---
# Tells Make these aren't actual files to generate
.PHONY: all clean unit_test profile profile-delayed

all: MAGPARSER.exe
# This target writes a small .f90 module containing the hash
version_mod.f90: ../.git/HEAD ../.git/index
	@echo "module version_mod" > $@
	@echo "  implicit none" >> $@
	@echo "  character(len=*), parameter :: commit_hash = '$(GIT_HASH)'" >> $@
	@echo "end module version_mod" >> $@

unit_test: test_contour.exe test_morton.exe test_polygonfracture.exe test_boxmerge.exe \
	   test_skiplist.exe test_compact_layer.exe test_viewer_index.exe

clean:
	rm -f *.o *.mod *.a *.exe

# Generating specific versions
#merge_utils.o: merge_utils.F90 SkipList_template.inc
#    $(FC) $(FFLAGS) -DPAYLOAD_TYPE="type(ScanBox)" -DPROC_PREFIX="scanbox_" -c merge_utils.F90 -o merge_utils.o

# --- Pattern Rules ---
# This single rule replaces all the individual ".f90 -> .o" targets.
# $< = the first dependency (the .f90 file)
# $@ = the target (the .o file)
#%.o: %.f90
#	$(FORTRAN_COMPILER) $(FCFLAGS) -gen-dep=$(@:.o=.d) -c $< -o $@
%.o: %.f90
	$(FORTRAN_COMPILER) $(FCFLAGS) -c $< -o $@
%.o: %.F90
	$(FORTRAN_COMPILER) $(FCFLAGS) -fpp -gen-dep=$(@:.o=.d) -c $< -o $@

# --- Library Creation ---
# Bundles all the core objects into a single static library.
# $^ = all dependencies (all files in LIB_OBJS)
$(LIBRARY): $(LIB_OBJS)
	ar rcs $@ $^

# --- Executable Builds ---
# By linking against the library, we don't have to list out all objects again.
# The layout DB (GDSII/OASIS reader, C++) is a sub-make; always re-run it so edits there relink.
db/liblayoutdb.a: FORCE
	$(MAKE) -C db liblayoutdb.a NVCOMP=$(NVCOMP)
FORCE:
.PHONY: FORCE

MAGPARSER.exe: mainmagparser.o $(LIBRARY) db/liblayoutdb.a
	$(FORTRAN_COMPILER) $(FCFLAGS) $^ -o $@ $(LDFLAGS) $(LDLIBS)

test_contour.exe: test_contour.o $(LIBRARY)
	$(FORTRAN_COMPILER) $(FCFLAGS) $^ -o $@ $(LDFLAGS) $(LDLIBS)
test_morton.exe: test_morton.o $(LIBRARY)
	$(FORTRAN_COMPILER) $(FCFLAGS) $^ -o $@ $(LDFLAGS) $(LDLIBS)
TRS_OPT.exe: trs_main.o trs_optimizer.o
	$(FORTRAN_COMPILER) $(FCFLAGS) $^ -o $@
trs_main.o: trs_optimizer.o
CONVERT.exe: test_polygonfracture.o $(LIBRARY)
	$(FORTRAN_COMPILER) $(FCFLAGS) $^ -o $@ $(LDFLAGS) $(LDLIBS)
test_boxmerge.exe: test_boxmerge.o $(LIBRARY)
	$(FORTRAN_COMPILER) $(FCFLAGS) $^ -o $@ $(LDFLAGS) $(LDLIBS)
test_skiplist.exe: test_skiplist.o $(LIBRARY)
	$(FORTRAN_COMPILER) $(FCFLAGS) $^ -o $@ $(LDFLAGS) $(LDLIBS)
test_compact_layer.exe: test_compact_layer.o $(LIBRARY)
	$(FORTRAN_COMPILER) $(FCFLAGS) $^ -o $@ $(LDFLAGS) $(LDLIBS)
test_compact_wire.exe: test_compact_wire.o $(LIBRARY)
	$(FORTRAN_COMPILER) $(FCFLAGS) $^ -o $@ $(LDFLAGS) $(LDLIBS)
test_viewer_index.exe: test_viewer_index.o $(LIBRARY)
	$(FORTRAN_COMPILER) $(FCFLAGS) $^ -o $@ $(LDFLAGS) $(LDLIBS)
generate_bin.exe: generate_bin.o $(LIBRARY)
	$(FORTRAN_COMPILER) $(FCFLAGS) $^ -o $@ $(LDFLAGS) $(LDLIBS)
test_interaction.exe:	test_interaction.f90 $(LIBRARY)
	$(FORTRAN_COMPILER) $(FCFLAGS) $^ -o $@ $(LDFLAGS) $(LDLIBS)
test_repetition.exe:	test_repetition.f90 $(LIBRARY)
	$(FORTRAN_COMPILER) $(FCFLAGS) $^ -o $@ $(LDFLAGS) $(LDLIBS)
BOOST_XOR_CHECKER.exe: boost_xor_checker.cpp
		       g++ -O3 -funroll-loops -I /scratch1/skoranne/OSS_EDA_TOOLS/boost/boost boost_xor_checker.cpp -o BOOST_XOR_CHECKER.exe
rpc_socket.o: rpc_socket.c
		       $(CC) -O2 -Wall -c rpc_socket.c -o $@
systeminfo_macos.o: systeminfo_macos.c
		       $(CC) -O3 -Wall -c systeminfo_macos.c -o $@
snappy_api.o:	       snappy_api.cpp
		       g++ -O3 -Wall -c snappy_api.cpp -o snappy_api.o
boost_polygon_api.o:   boost_polygon_api.cpp
		       g++ -O3 -funroll-loops -I /scratch1/skoranne/OSS_EDA_TOOLS/boost/boost boost_polygon_api.cpp -c
ifeq ($(GPU),0)
event_sorter.o:	       event_sorter.cu
		       g++ -x c++ -O3 -c event_sorter.cu
gpu_morton.o:   gpu_morton.cu
		       g++ -O3 -c -x c++ gpu_morton.cu
else
event_sorter.o:	       event_sorter.cu
		       $(NVCC) $(NVCCFLAGS) -c event_sorter.cu
gpu_morton.o:   gpu_morton.cu
		       $(NVCC) $(NVCCFLAGS) -c gpu_morton.cu
endif
# Nsight Systems profiling for nvfortran+OpenMP target offload (GB10). Example:
#   make -f Makefile.nvf profile CTR=check_interactions.ctr LAYERS=10
#   make -f Makefile.nvf profile-delayed NSYS_DELAY=30 NSYS_DUR=60 CTR=check_interactions.ctr LAYERS=10
CTR ?= regress_boolean_ops.ctr
LAYERS ?= 10
profile: MAGPARSER.exe
	$(NSYS) profile -t $(NSYS_TRACE) --cuda-memory-usage=true --stats=true \
	  -o $(NSYS_OUT) --force-overwrite true \
	  ./MAGPARSER.exe $(CTR) $(LAYERS)

profile-delayed: MAGPARSER.exe
	$(NSYS) profile -t $(NSYS_TRACE) --cuda-memory-usage=true --stats=true \
	  --delay=$(NSYS_DELAY) --duration=$(NSYS_DUR) \
	  -o $(NSYS_OUT)_d$(NSYS_DELAY)_t$(NSYS_DUR) --force-overwrite true \
	  ./MAGPARSER.exe $(CTR) $(LAYERS)

ALL_EXE:    CONVERT.exe test_interaction.exe test_repetition.exe BOOST_XOR_CHECKER.exe generate_bin.exe test_contour.exe

# ---- MAGVIEWER (GLFW + system libGL; GLFW built from source as a static X11 library) ----
GLFW_HOME ?= /home/skoranne/OSS_DOWNLOADS/glfw
GLFW_INC  ?= $(GLFW_HOME)/include
GLFW_LIB  ?= $(GLFW_HOME)/build/src/libglfw3.a
LIBGL     ?= $(firstword $(wildcard /usr/lib/aarch64-linux-gnu/libGL.so.1 /usr/lib/x86_64-linux-gnu/libGL.so.1 /usr/lib64/libGL.so.1))
viewer_gl.o: viewer_gl.c
	gcc -c -O2 -I$(GLFW_INC) viewer_gl.c -o $@
viewer_font.o: viewer_font.f90
	$(FORTRAN_COMPILER) -c -O2 viewer_font.f90 -o $@
test_layout_files.exe: test_layout_files.f90 viewer_tiles.o $(LIBRARY) db/liblayoutdb.a
	$(FORTRAN_COMPILER) $(FCFLAGS) test_layout_files.f90 viewer_tiles.o $(LIBRARY) -o $@ $(LDFLAGS) $(LDLIBS)
viewer_tiles.o: viewer_tiles.f90 $(LIBRARY)
	$(FORTRAN_COMPILER) $(FCFLAGS) -c viewer_tiles.f90 -o $@
MAGVIEWER.exe: magviewer.f90 $(LIBRARY) viewer_gl.o viewer_font.o viewer_tiles.o db/liblayoutdb.a
	$(FORTRAN_COMPILER) $(FCFLAGS) magviewer.f90 viewer_font.o viewer_tiles.o $(LIBRARY) viewer_gl.o $(GLFW_LIB) $(LIBGL) -ldl -lm -o MAGVIEWER.exe $(LDFLAGS) $(LDLIBS)
