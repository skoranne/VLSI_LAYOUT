# FASCL per-polygon properties + OASIS output regression (run from the directory holding the inputs;
# see run_fascl_regression.sh).  Layers from GDSII are named L<layer>_<datatype>.
program fascl_props
var temp_folder /tmp
var temporary_layers 2
decl design d1 = fascl_in.gds
decl output o1 = fascl_out.mag
info
# --- 68/20: unique per-polygon properties
PROPERTY:PNUM = d1:L68_20 FASCL [ (id) PNUM = POLYGON_NUMBER(id) ] d1:nothing
exec run PROPERTY:AREA_UM2,KIND = d1:L68_20 FASCL [ (id) a = AREA(id); AREA_UM2 = a / 1000000.0; KIND = IF(NUM_BOXES(id) == 1, "rect", "poly" + STRING(NUM_BOXES(id))) ] nothing
PROPERTY:INFO = d1:L68_20 FASCL [ (id) INFO = STRUCT(w = BBOX_WIDTH(id), h = BBOX_HEIGHT(id), pn = PNUM(id)); INFO.tag = "m1 " + STRING(PNUM(id) % 3) ] d1:nothing
PROPERTY:BIG = d1:L68_20 FASCL [ (id) WHEN AREA(id) > 1000000; BIG = 1 ] d1:nothing
PROPERTY:CHK = d1:L68_20 FASCL [ (id) INFO.pn(id) * 1000 + INFO.w(id) % 7 + 2 * (KIND(id) == "rect") ] d1:nothing
exec propinfo d1:L68_20
exec propdump d1:L68_20 fascl_m1.csv
# --- 69/20: low-cardinality properties, the writer can build repetitions
PROPERTY:K,SHAPE = d1:L69_20 FASCL [ (id) K = NUM_BOXES(id); SHAPE = IF(K == 1, "rect", "ell") ] d1:nothing
exec propdump d1:L69_20 fascl_m2.csv
# --- 70/20: one property, bare-expression lambda form
PROPERTY:ROWY = d1:L70_20 FASCL [ (id) BBOX_Y1(id) ] d1:nothing
# --- OASIS outputs: default (STRICT + CBLOCK + repetitions), then without repetitions / CBLOCK
exec oasout d1 fascl_full.oas
var oasis_cblock_bytes 64
exec oasout d1 fascl_smallcb.oas
var oasis_cblock_bytes 0
var oasis_repetition 0
exec oasout d1 fascl_norep.oas
var oasis_repetition 1
var oasis_cblock 0
var oasis_strict 0
exec oasout d1:L68_20 fascl_plain_m1.oas
var oasis_cblock 1
var oasis_strict 1
# --- properties travel with COPY into an output db whose .mag names an .oas file
exec run o1:met1 = d1:L68_20 COPY nothing
flush
end
