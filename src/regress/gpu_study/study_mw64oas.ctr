# GPU study (MW64 li1, ~825M boxes): R-tree kernels only; ^ only with MAGPARSER_XOR_VIA_NOT=1.
program study_mw64oas
systeminfo
var temp_folder /home/skoranne/.claude/jobs/560e4036/tmp/study_mw64oas/
var temporary_layers 2
var abort_on_xor 0
var abort_on_assert_zero 0
var debug_verbosity 0
decl design d1 = /scratch1/skoranne/OSS_EDA_TOOLS/DESIGNS/MW16_DATA/MW64.oas
decl memory m1 = nothing
info
exec init m1:nothing
exec run m1:li_g = d1:L67_D20 GROW nothing 0.001 0.001 0.001 0.001
exec run m1:r = m1:li_g ~ d1:L67_D20
exec run m1:r = m1:r * d1:L67_D20
exec run m1:r = m1:li_g INTERACT d1:L67_D20
exec run m1:r = m1:li_g ^ d1:L67_D20
end
