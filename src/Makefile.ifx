################################################################################
# File   : Makefile.ifx
# Author : Sandeep Koranne (Refactored)
################################################################################
# --- Compiler & Flags ---
DEBUG ?= 0
STRICT ?= 0
VERBOSE ?= 0
PROFILE ?= 0
USE_HDF5 ?= 0
# Paths (override for local machine, e.g. Macbook)
BOOST_DIR ?= /scratch1/skoranne/OSS_EDA_TOOLS/boost/boost
CPPFLAGS_EXTRA ?=
THRUST_INCLUDE ?= -I/scratch1/skoranne/OSS_EDA_TOOLS/cccl/thrust  -I/scratch1/skoranne/OSS_EDA_TOOLS/cccl/libcudacxx/include
THRUST_OPTIONS ?= -std=c++17 -DTHRUST_DEVICE_SYSTEM=THRUST_DEVICE_SYSTEM_CPP -DTHRUST_HOST_SYSTEM=THRUST_HOST_SYSTEM_CPP -D__CUB_INTERNAL_REDUCE__=0

FORTRAN_COMPILER ?= ifx
FC := $(FORTRAN_COMPILER)

ifeq ($(USE_HDF5),1)
  export HDF5_FC ?= mpiifx
  export HDF5_Fortran_COMPILER ?= mpiifx
  FCFLAGS_EXTRA += -DUSE_HDF5
  LINKER_FC := $(HDF5_FC)
else
  LINKER_FC := $(FC)
endif

ifeq ($(DEBUG),1)
   FCFLAGS = -fpp -g -O0 -check bounds -check all -traceback -warn all -qopenmp $(FCFLAGS_EXTRA)
else
   FCFLAGS = -g -fpp -O3 -parallel -qopenmp -qopt-report=3 -xHost $(FCFLAGS_EXTRA)
endif
ifeq ($(STRICT),1)
   FCFLAGS += -stand f18 -warn all -warn interfaces -warn unused -check bounds -check pointers -check uninit -traceback
endif
ifeq ($(PROFILE),1)
   FCFLAGS += -pg
endif

GIT_HASH := $(shell git rev-parse --short HEAD)
# --- Linker Variables (override LDFLAGS/LDLIBS for local machine) ---
LDFLAGS ?=
LDLIBS ?= db/liblayoutdb.a -lz -lstdc++ -lsnappy -lzstd
ifeq ($(USE_HDF5),1)
  LDLIBS += -lhdf5_fortran -lhdf5
endif

# --- Library Definition ---
LIBRARY = libmagparser.a

db/liblayoutdb.a:
	$(MAKE) -C db all

include DEPENDENCIES.txt

hdfdata.o:	hdfdata.f90
	$(FC) $(FCFLAGS) -c $< -o $@
#skiplist_module.o

# Create a list of all object files that will be compiled
ALL_OBJS = $(LIB_OBJS) mainmagparser.o test_contour.o

# Derive a list of dependency (.d) files from the object list
DEP_FILES = $(ALL_OBJS:.o=.d)

# --- Phony Targets ---
# Tells Make these aren't actual files to generate
.PHONY: all clean unit_test

all: MAGPARSER.exe
# This target writes a small .f90 module containing the hash
version_mod.f90: ../.git/HEAD ../.git/index
	@echo "module version_mod" > $@
	@echo "  implicit none" >> $@
	@echo "  character(len=*), parameter :: commit_hash = '$(GIT_HASH)'" >> $@
	@echo "end module version_mod" >> $@

unit_test: test_contour.exe test_morton.exe CONVERT.exe test_boxmerge.exe \
	   test_skiplist.exe

clean:
	rm -f *.o *.mod *.a *.exe

# Generating specific versions
#merge_utils.o: merge_utils.F90 SkipList_template.inc
#    $(FC) $(FFLAGS) -DPAYLOAD_TYPE="type(ScanBox)" -DPROC_PREFIX="scanbox_" -c merge_utils.F90 -o merge_utils.o

# --- Pattern Rules ---
# This single rule replaces all the individual ".f90 -> .o" targets.
# $< = the first dependency (the .f90 file)
# $@ = the target (the .o file)
#%.o: %.f90
#	$(FORTRAN_COMPILER) $(FCFLAGS) -gen-dep=$(@:.o=.d) -c $< -o $@
%.o: %.f90
	$(FORTRAN_COMPILER) $(FCFLAGS) -c $< -o $@
%.o: %.F90
	$(FORTRAN_COMPILER) $(FCFLAGS) -fpp -c $< -o $@

# --- Library Creation ---
# Bundles all the core objects into a single static library.
# $^ = all dependencies (all files in LIB_OBJS)
$(LIBRARY): $(LIB_OBJS)
	ar rcs $@ $^

# --- Executable Builds ---
# By linking against the library, we don't have to list out all objects again.
MAGPARSER.exe: mainmagparser.o $(LIBRARY) db/liblayoutdb.a
	$(LINKER_FC) $(FCFLAGS) $^ -o $@ $(LDFLAGS) $(LDLIBS)

test_contour.exe: test_contour.o $(LIBRARY)
	$(LINKER_FC) $(FCFLAGS) $^ -o $@ $(LDFLAGS) $(LDLIBS)
test_morton.exe: test_morton.o $(LIBRARY)
	$(LINKER_FC) $(FCFLAGS) $^ -o $@ $(LDFLAGS) $(LDLIBS)
CONVERT.exe: test_polygonfracture.o $(LIBRARY)
	$(LINKER_FC) $(FCFLAGS) $^ -o $@ $(LDFLAGS) $(LDLIBS)
test_boxmerge.exe: test_boxmerge.o $(LIBRARY)
	$(LINKER_FC) $(FCFLAGS) $^ -o $@ $(LDFLAGS) $(LDLIBS)
test_skiplist.exe: test_skiplist.o $(LIBRARY)
	$(FC) $(FCFLAGS) $^ -o $@ $(LDFLAGS) $(LDLIBS)
generate_bin.exe: generate_bin.o $(LIBRARY)
	$(LINKER_FC) $(FCFLAGS) $^ -o $@ $(LDFLAGS) $(LDLIBS)
test_interaction.exe:	test_interaction.f90 $(LIBRARY)
	$(FORTRAN_COMPILER) $(FCFLAGS) $^ -o $@ $(LDFLAGS) $(LDLIBS)
test_repetition.exe:	test_repetition.f90 $(LIBRARY)
	$(FORTRAN_COMPILER) $(FCFLAGS) $^ -o $@ $(LDFLAGS) $(LDLIBS)
BOOST_XOR_CHECKER.exe: boost_xor_checker.cpp
		       g++ -O3 -funroll-loops -I$(BOOST_DIR) boost_xor_checker.cpp -o BOOST_XOR_CHECKER.exe
systeminfo_macos.o: systeminfo_macos.c
		       $(CC) -O3 -Wall -c systeminfo_macos.c -o $@
snappy_api.o:	       snappy_api.cpp
		       g++ -O3 -Wall $(CPPFLAGS_EXTRA) -c snappy_api.cpp 
boost_polygon_api.o:   boost_polygon_api.cpp
		       g++ -O3 -funroll-loops -I$(BOOST_DIR) $(CPPFLAGS_EXTRA) boost_polygon_api.cpp -c
event_sorter.o:	       event_sorter.cu
		       g++ -x c++ -O3 -c event_sorter.cu
gpu_morton.o:	gpu_morton.cu
	g++ -O3 -c -x c++ gpu_morton.cu
MAGVIEWER.exe:	magviewer.f90 $(LIBRARY)
		ifx -c -O3 -fpp glf90w.F90
		ifx $(FCFLAGS) -fpp -fopenmp magviewer.f90 $(LIBRARY) glf90w.o -L ./lib/ifx -lglfw -lGL -o MAGVIEWER.exe $(LDFLAGS) $(LDLIBS)
       
ALL_EXE:    CONVERT.exe test_interaction.exe test_repetition.exe BOOST_XOR_CHECKER.exe generate_bin.exe MAGVIEWER.exe
