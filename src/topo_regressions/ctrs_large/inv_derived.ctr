exec run m:z_d315_ich = m:c_d315_ich ASSERT_ZERO nothing
exec run m:c_d315_io = m:r_d315_INSIDE * m:r_d315_OUTSIDE
exec run m:z_d315_io = m:c_d315_io ASSERT_ZERO nothing
exec run m:c_d315_co = m:r_d315_CUT * m:r_d315_OUTSIDE
exec run m:z_d315_co = m:c_d315_co ASSERT_ZERO nothing
exec run m:c_d315_to = m:r_d315_TOUCH * m:r_d315_OUTSIDE
exec run m:z_d315_to = m:c_d315_to ASSERT_ZERO nothing
exec run m:c_d315_ci = m:r_d315_CUT * m:r_d315_INSIDE
exec run m:z_d315_ci = m:c_d315_ci ASSERT_ZERO nothing
exec run m:c_d315_ti = m:r_d315_TOUCH * m:r_d315_INSIDE
exec run m:z_d315_ti = m:c_d315_ti ASSERT_ZERO nothing
exec run m:c_d315_tc = m:r_d315_TOUCH * m:r_d315_CUT
exec run m:z_d315_tc = m:c_d315_tc ASSERT_ZERO nothing
end
