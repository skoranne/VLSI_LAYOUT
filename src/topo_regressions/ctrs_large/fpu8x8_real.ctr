exec run m:z_t15_to = m:c_t15_to ASSERT_ZERO nothing
exec run m:c_t15_ci = m:r_t15_CUT * m:r_t15_INSIDE
exec run m:z_t15_ci = m:c_t15_ci ASSERT_ZERO nothing
exec run m:c_t15_ti = m:r_t15_TOUCH * m:r_t15_INSIDE
exec run m:z_t15_ti = m:c_t15_ti ASSERT_ZERO nothing
exec run m:c_t15_tc = m:r_t15_TOUCH * m:r_t15_CUT
exec run m:z_t15_tc = m:c_t15_tc ASSERT_ZERO nothing
end
