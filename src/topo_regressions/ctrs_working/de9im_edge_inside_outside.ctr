program de9im_edge_inside_outside
var temp_folder /tmp/de9im_edge_inside_outside/
var temporary_layers 2
var abort_on_assert_zero 2
decl design d = ../examples/INV.mag
decl memory m = nothing
exec init m:nothing
exec run m:g5 = d:poly GROW nothing 5 5 5 5
exec run m:t_in_g5_INSIDE_EDGE_r = d:poly INSIDE_EDGE m:g5
exec run m:t_in_g5_NOT_INSIDE_EDGE_r = d:poly NOT_INSIDE_EDGE m:g5
exec run m:t_in_g5_INSIDE_EDGE_ch = m:t_in_g5_INSIDE_EDGE_r * m:t_in_g5_NOT_INSIDE_EDGE_r
exec run m:t_in_g5_INSIDE_EDGE_un = m:t_in_g5_INSIDE_EDGE_r + m:t_in_g5_NOT_INSIDE_EDGE_r
exec run m:t_in_g5_INSIDE_EDGE_px = m:t_in_g5_INSIDE_EDGE_un ^ m:t_in_g5_INSIDE_EDGE_r
exec run m:t_in_g5_INSIDE_EDGE_p1 = m:t_in_g5_INSIDE_EDGE_px * m:t_in_g5_INSIDE_EDGE_r
exec run m:t_in_g5_INSIDE_EDGE_p1z = m:t_in_g5_INSIDE_EDGE_p1 ASSERT_ZERO nothing
