program de9im_edge_coincident
var temp_folder /tmp/de9im_edge_coincident/
var temporary_layers 2
var abort_on_assert_zero 2
decl design d = ../examples/INV.mag
decl memory m = nothing
exec init m:nothing
exec run m:g_up = d:poly GROW nothing 0 5 0 0
exec run m:t_cin_up_INSIDE_EDGE_r = d:poly INSIDE_EDGE m:g_up
exec run m:t_cin_up_NOT_INSIDE_EDGE_r = d:poly NOT_INSIDE_EDGE m:g_up
