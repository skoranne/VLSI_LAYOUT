# Repurposed from crash.ctr: KLBIN/MAG design references replaced with OASIS files from /scratch1/skoranne/DESIGNS/
# OASIS input: flattened with `decl hierdesign` (plain `decl design` loads only each cell's own boxes
# at the origin). OASIS layers are named by GDS number, so sky130 names are mapped: nwell L64_D20,
# diff L65_D20, poly L66_D20, li1 L67_D20, met1..met5 L68_D20..L72_D20. Run with MAX_LAYERS >= 34
# (MICROWATT.oas has 34 layer/datatype pairs), e.g. MAGPARSER.exe <ctr> 64.
# Control file for MAGPARSER for SKYWATER 130A process
# Designed by Sandeep Koranne (C) 1997-
# VLSI Magic Layout Editor
program SDT16_6x6
systeminfo
var temp_folder MTL_TEMP_5zf/
var temporary_layers 2
var abort_on_xor 1
var abort_on_assert_zero 2
var debug_verbosity 1
decl hierdesign d1_input = /scratch1/skoranne/DESIGNS/microwatt-mpw7/gds/MW_FLAT.oas
# decl design d1_input = /scratch1/skoranne/DESIGNS/microwatt-mpw7/gds/MICROWATT.oas
# decl design d1_input = /scratch1/skoranne/DESIGNS/microwatt-mpw7/gds/MICROWATT.oas
# decl design d1_input = /scratch1/skoranne/DESIGNS/microwatt-mpw7/gds/MICROWATT.oas
# decl design d1 = /scratch1/skoranne/DESIGNS/microwatt-mpw7/gds/MICROWATT.oas
# decl design d1_input = D1_INPUT
decl output o1 = SKYWATER130A_output.mag
decl memory d1 = nothing
decl memory t1 = nothing
decl memory t2 = nothing
info
exec init t1:nothing
exec run d1:poly = d1_input:L66_D20 COPY nothing
exec run d1:diff = d1_input:L65_D20 COPY nothing
exec run d1:met1 = d1_input:L68_D20 COPY nothing
exec run d1:li1 =  d1_input:L67_D20 COPY nothing
exec run d1:met2 = d1_input:L69_D20 COPY nothing
delete d1_input
flush
# Generating `t1',`d1',`poly',`0.001'
exec run t1:poly_1 = d1:poly GROW t1:nothing 0.001 0.001 0.001 0.001
exec run t1:poly_2 = d1:poly SIZE t1:nothing -0.001
exec run t1:poly_outer_ring = t1:poly_1 ~ d1:poly
exec run t1:poly_inner_ring = d1:poly ~ t1:poly_2
exec run t1:poly_ring_and1  = t1:poly_outer_ring * d1:poly
exec run t1:poly_ring_intersection  = t1:poly_outer_ring * t1:poly_inner_ring
exec run t1:nothing = t1:poly_ring_and1 ASSERT_ZERO t1:nothing
exec run t1:nothing = t1:poly_ring_intersection ASSERT_ZERO t1:nothing
# Generating `t1',`d1',`li1',`0.001'
exec run t1:li1_1 = d1:li1 GROW t1:nothing 0.001 0.001 0.001 0.001
exec run t1:li1_2 = d1:li1 SIZE t1:nothing -0.001
exec run t1:li1_outer_ring = t1:li1_1 ~ d1:li1
exec run t1:li1_inner_ring = d1:li1 ~ t1:li1_2
exec run t1:li1_ring_and1  = t1:li1_outer_ring * d1:li1
exec run t1:li1_ring_intersection  = t1:li1_outer_ring * t1:li1_inner_ring
exec run t1:nothing = t1:li1_ring_and1 ASSERT_ZERO t1:nothing
exec run t1:nothing = t1:li1_ring_intersection ASSERT_ZERO t1:nothing
# Generating `t1',`d1',`met1',`0.001'
exec run t1:met1_1 = d1:met1 GROW t1:nothing 0.001 0.001 0.001 0.001
exec run t1:met1_2 = d1:met1 SIZE t1:nothing -0.001
exec run t1:met1_outer_ring = t1:met1_1 ~ d1:met1
exec run t1:met1_inner_ring = d1:met1 ~ t1:met1_2
exec run t1:met1_ring_and1  = t1:met1_outer_ring * d1:met1
exec run t1:met1_ring_intersection  = t1:met1_outer_ring * t1:met1_inner_ring
exec run t1:nothing = t1:met1_ring_and1 ASSERT_ZERO t1:nothing
exec run t1:nothing = t1:met1_ring_intersection ASSERT_ZERO t1:nothing
# Generating `t1',`d1',`met2',`0.001'
exec run t1:met2_1 = d1:met2 GROW t1:nothing 0.001 0.001 0.001 0.001
exec run t1:met2_2 = d1:met2 SIZE t1:nothing -0.001
exec run t1:met2_outer_ring = t1:met2_1 ~ d1:met2
exec run t1:met2_inner_ring = d1:met2 ~ t1:met2_2
exec run t1:met2_ring_and1  = t1:met2_outer_ring * d1:met2
exec run t1:met2_ring_intersection  = t1:met2_outer_ring * t1:met2_inner_ring
exec run t1:nothing = t1:met2_ring_and1 ASSERT_ZERO t1:nothing
exec run t1:nothing = t1:met2_ring_intersection ASSERT_ZERO t1:nothing
end 

