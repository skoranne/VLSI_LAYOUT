# Repurposed from SDT2.ctr: KLBIN/MAG design references replaced with OASIS files from /scratch1/skoranne/DESIGNS/
# OASIS input: flattened with `decl hierdesign` (plain `decl design` loads only each cell's own boxes
# at the origin). OASIS layers are named by GDS number, so sky130 names are mapped: nwell L64_D20,
# diff L65_D20, poly L66_D20, li1 L67_D20, met1..met5 L68_D20..L72_D20. Run with MAX_LAYERS >= 34
# (MICROWATT.oas has 34 layer/datatype pairs), e.g. MAGPARSER.exe <ctr> 64.
# Control file for MAGPARSER for SKYWATER 130A process
# Designed by Sandeep Koranne (C) 1997-
# VLSI Magic Layout Editor
include(`/home/skoranne/GITHUB/VLSI_LAYOUT/src/op_template.m4')dnl
program SDT16_6x6
systeminfo
var temp_folder mkTempFolder
var temporary_layers 2
var abort_on_xor 1
var abort_on_assert_zero 2
var debug_verbosity 3
decl hierdesign d1_input = /scratch1/skoranne/DESIGNS/microwatt-mpw7/gds/MW_FLAT.oas
# decl design d1_input = /scratch1/skoranne/DESIGNS/microwatt-mpw7/gds/MICROWATT.oas
# decl design d1_input = /scratch1/skoranne/DESIGNS/microwatt-mpw7/gds/MICROWATT.oas
# decl design d1_input = /scratch1/skoranne/DESIGNS/microwatt-mpw7/gds/MICROWATT.oas
# decl design d1 = /scratch1/skoranne/DESIGNS/microwatt-mpw7/gds/MICROWATT.oas
# decl design d1_input = D1_INPUT
decl output o1 = SKYWATER130A_output.mag
decl memory d1 = nothing
decl memory t1 = nothing
decl memory t2 = nothing
info
exec init t1:nothing
exec run d1:poly = d1_input:L66_D20 COPY nothing
exec run d1:diff = d1_input:L65_D20 COPY nothing
exec run d1:met1 = d1_input:L68_D20 COPY nothing
exec run d1:li1 =  d1_input:L67_D20 COPY nothing
exec run d1:met2 = d1_input:L69_D20 COPY nothing
delete d1_input
flush
RUN_LOOP(`OP1',`t1',`d1',`poly',`0.001',`li1',`0.001',`met1',`0.001',`met2',`0.001')dnl
end 

