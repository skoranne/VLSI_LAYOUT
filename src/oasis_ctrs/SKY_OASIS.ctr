# Repurposed from SKY.ctr: KLBIN/MAG design references replaced with OASIS files from /scratch1/skoranne/DESIGNS/
# OASIS input: flattened with `decl hierdesign` (plain `decl design` loads only each cell's own boxes
# at the origin). OASIS layers are named by GDS number, so sky130 names are mapped: nwell L64_D20,
# diff L65_D20, poly L66_D20, li1 L67_D20, met1..met5 L68_D20..L72_D20. Run with MAX_LAYERS >= 34
# (MICROWATT.oas has 34 layer/datatype pairs), e.g. MAGPARSER.exe <ctr> 64.
# Control file for MAGPARSER for SKYWATER 130A process
# Designed by Sandeep Koranne (C) 1997-
# VLSI Magic Layout Editor
program SKYWATER130A
systeminfo
# decl design d1 = /scratch1/skoranne/DESIGNS/microwatt-mpw7/gds/MW4x4.oas
decl hierdesign d1 = /scratch1/skoranne/DESIGNS/microwatt-mpw7/gds/MW_FLAT.oas
# decl design d1 = /scratch1/skoranne/DESIGNS/microwatt-mpw7/gds/MICROWATT.oas
# decl design d1 = /scratch1/skoranne/DESIGNS/microwatt-mpw7/gds/MICROWATT.oas
# decl design d1 = /scratch1/skoranne/DESIGNS/microwatt-mpw7/gds/MICROWATT.oas
# decl design d1 = /scratch1/skoranne/DESIGNS/microwatt-mpw7/gds/MICROWATT.oas
decl output o1 = SKYWATER130A_output.mag
decl memory t1 = nothing
decl memory t2 = nothing
info
exec run o1:met1_grow = d1:L68_D20 GROW nothing 0.1 0.1 0.1 0.1
exec run o1:poly_retarget = d1:L66_D20 GROW nothing 0.2 0.1 0.2 0.2
exec run o1:diff = d1:L67_D20 COPY nothing
exec run o1:poly = d1:L66_D20 COPY nothing
exec run o1:gate = d1:L66_D20 * d1:L65_D20
exec run t1:ng_poly2 = d1:L66_D20 ~ o1:gate
exec run o1:sd2  = d1:L65_D20 ~ d1:L66_D20
exec run t1:poly_grow = d1:L66_D20 SIZE nothing 0.01
exec run t1:poly_shrink = d1:L66_D20 SIZE nothing -0.01
exec run o1:poly_outer_ring = t1:poly_grow ! d1:L66_D20
exec run o1:poly_inner_ring = d1:L66_D20 ! t1:poly_shrink
flush
delete t1
# All poly/gate temporary layers deleted
exec run o1:li1  = d1:L67_D20 COPY nothing
exec run o1:met1 = d1:L68_D20 COPY nothing
exec run t2:met1_grow = d1:L68_D20 SIZE nothing 0.01
exec run t2:met1_shrink = d1:L68_D20 SIZE nothing -0.01
exec run o1:met1_outer_ring = t2:met1_grow ! d1:L68_D20
exec run o1:met1_inner_ring = d1:L68_D20 ! t2:met1_shrink
delete t2
delete d1
flush
delete o1
end 
